#!/usr/bin/env bash
set -eu

# Pre-commit hook for monorepo
# 1. Run lint-staged for formatting and lint fixes
# 2. Run code quality checks (unused code + types) for changed areas

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "Running lint-staged..."
npx lint-staged

# --- Backend checks ---
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^backend/\(src\|tests\)/.*\.py$'; then
  echo "Running ruff unused code check for backend..."
  (cd "$ROOT/backend" && env ENV=dev uv run --no-sync ruff check --ignore-noqa --select F,ARG src/doc_process_studio tests/)

  echo "Running vulture dead code check for backend..."
  (cd "$ROOT/backend" && env ENV=dev uv run --no-sync vulture src/doc_process_studio --min-confidence 60)

  echo "Running mypy type check for backend..."
  (cd "$ROOT/backend" && env ENV=dev uv run --no-sync mypy src/doc_process_studio)
fi

# --- Frontend checks ---
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^frontend/\(src\|tests\)/.*\.\(ts\|vue\)$'; then
  echo "Running vue-tsc check for frontend (unused code + types)..."
  (cd "$ROOT/frontend" && npx vue-tsc --noEmit)

  echo "Running knip unused code check for frontend..."
  (cd "$ROOT/frontend" && npx knip --no-progress)
fi
