# .env.prod.example  —— 生产环境变量模板（提交到仓库作参考）
#
# 用法：
#   1) 复制为部署机上的 .env（根目录，已被 .gitignore 忽略，不会泄露）：
#        cp .env.prod.example .env
#   2) 把下面所有 <...> 占位符替换为真实值，尤其 4 个密钥务必强随机；
#   3) SETTINGS_ENCRYPTION_KEY 生成命令：
#        python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#   4) 提交本 .example 文件，但 .env 本身绝不入库（已 gitignore）。
#
# 注意：RAGFLOW_API_KEY 这里故意留空——生产设计是管理员首次登录后在
# 「系统设置」页填入并加密入库（见 config.py 注释）。留空不会启动失败，
# 但 RAGFlow 检索功能在填入前不可用。

# ---- 非密钥配置（可入库，无敏感信息）----
ENV=prod
OLLAMA_BASE_URL=http://59.152.224.254:8081
REDIS_KEY_PREFIX=doc-process-studio
REDIS_TTL_SECONDS=43200
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
RAGFLOW_ENABLED=true
RAGFLOW_BASE_URL=http://s.gdautotoll.com.cn:10108
RAGFLOW_SIMILARITY_THRESHOLD=0.55
RAGFLOW_TOP_K=3
RAGFLOW_PARSE_TIMEOUT_SECONDS=60
POSTGRES_USER=admin
POSTGRES_DB=master

# ---- 密钥（真实值写在部署机的 .env，切勿提交）----
POSTGRES_PASSWORD=<替换为强密码，且需与 db 服务 POSTGRES_PASSWORD 一致>
REDIS_PASSWORD=<替换为强密码，且需与 redis --requirepass 一致>
JWT_SECRET_KEY=<至少 32 位随机串；请勿使用示例弱值，部署前必须生成并妥善保管>
ADMIN_PASSWORD=<替换默认 admin123>
SETTINGS_ENCRYPTION_KEY=<运行上面的 python 命令生成；ENV=prod 缺它会启动失败>
RAGFLOW_API_KEY=<可选：留空，上线后在设置页填；或在此预填>
