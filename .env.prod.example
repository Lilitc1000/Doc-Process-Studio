# .env.prod.example  —— 生产环境变量模板（提交到仓库作参考）
#
# 用法：
#   1) 复制为部署机上的 .env（根 .gitignore 已忽略 .env，不会入库）：
#        cp .env.prod.example /opt/dps/.env
#   2) 把下面所有 <...> 占位符替换为真实值，尤其以下密钥务必强随机：
#        POSTGRES_PASSWORD / REDIS_PASSWORD / JWT_SECRET_KEY / SETTINGS_ENCRYPTION_KEY
#   3) SETTINGS_ENCRYPTION_KEY 生成命令：
#        python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#   4) 把 .env 放在 rsync 同步目录【之外】（如 /opt/dps/.env），并在部署作业里用
#        docker compose --env-file /opt/dps/.env -f docker-compose.prod.yml ... 读取；
#        切勿放在仓库根目录让 rsync 覆盖进来——下一次部署的 rsync --delete 会把它删掉。
#   5) 提交本 .example 文件，但 .env 本身绝不入库。
#
# 注意：RAGFlow 的全部配置（Base URL、API Key、启用开关、检索参数、启用章节等）
# 均不在本文件配置——生产设计是管理员首次登录后，在「系统设置」页逐项填写并加密入库，
# 留空不会启动失败，但 RAGFlow 检索功能在配置前不可用。该页也可管理未来新增的第三方密钥。

# ---- 非密钥配置（可入库，无敏感信息）----
ENV=prod
OLLAMA_BASE_URL=http://59.152.224.254:8081
REDIS_KEY_PREFIX=doc-process-studio
REDIS_TTL_SECONDS=43200
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
POSTGRES_USER=admin
POSTGRES_DB=master

# ---- 密钥（真实值写在部署机的 .env，切勿提交）----
POSTGRES_PASSWORD=<替换为强密码，且需与 db 服务 POSTGRES_PASSWORD 一致>
REDIS_PASSWORD=<替换为强密码，且需与 redis --requirepass 一致>
JWT_SECRET_KEY=<至少 32 位随机串；请勿使用示例弱值，部署前必须生成并妥善保管>
SETTINGS_ENCRYPTION_KEY=<运行上面的 python 命令生成；ENV=prod 缺它会启动失败>
