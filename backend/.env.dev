# ---- RAGFlow 知识增强（报告侧检索）----
# 注意：API Key 目前暂时随 .env.dev 入库，仅供内网开发共用；
# 正式环境应改为通过环境变量注入，避免密钥入库。
RAGFLOW_ENABLED=true
RAGFLOW_BASE_URL=http://s.gdautotoll.com.cn:10108
RAGFLOW_DATASETS_JSON={"history":["f05e5a4aadac11f1b9211b18c23af0c8"]}
RAGFLOW_SIMILARITY_THRESHOLD=0.55
RAGFLOW_TOP_K=3

# ---- 知识库索引后端（RAGFlow）----
# RAGFlow 为唯一索引后端：文档解析 / 切块 / 向量化均由 RAGFlow 服务端完成。
# 项目名 -> RAGFlow dataset 映射（按现有 dataset 直接读取，不改语言标注）
# 未命中映射时的兜底 dataset
RAGFLOW_PARSE_TIMEOUT_SECONDS=60
