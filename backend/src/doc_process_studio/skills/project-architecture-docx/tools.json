{
  "tools": [
    {
      "name": "generate_document",
      "description": "根据已整理好的 doc_plan 生成文件产物，并返回可下载文件信息。",
      "kind": "script",
      "path": "scripts/generate_architecture_doc.py",
      "parameters": {
        "type": "object",
        "properties": {
          "system_name": {
            "type": "string",
            "description": "文档封面上的系统名称。"
          },
          "document_title": {
            "type": "string",
            "description": "文档标题。"
          },
          "version": {
            "type": "string",
            "description": "版本号，默认 1.0。"
          },
          "output_name": {
            "type": "string",
            "description": "期望生成的文件名。"
          },
          "doc_plan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "chapters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "章节标题"
                        },
                        "content": {
                          "description": "该章节的正文内容，必须是完整的段落文字而非子节标题大纲。",
                          "anyOf": [
                            { "type": "string" },
                            { "type": "array", "items": { "type": "string" } }
                          ]
                        },
                        "sections": {
                          "type": "array",
                          "description": "子章节数组，递归结构。子节标题必须放在 sections 中，不能平铺在 content 里。",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": { "type": "string", "description": "子章节标题" },
                              "content": {
                                "description": "子章节正文内容",
                                "anyOf": [
                                  { "type": "string" },
                                  { "type": "array", "items": { "type": "string" } }
                                ]
                              },
                              "sections": {
                                "type": "array",
                                "description": "更深层的子章节",
                                "items": { "type": "object" }
                              }
                            },
                            "required": ["title", "content"]
                          }
                        }
                      },
                      "required": ["title", "content"]
                    }
                  }
                },
                "required": ["chapters"]
              },
              {
                "type": "array",
                "description": "章节列表（无需 chapters 包裹）"
              },
              {
                "type": "string",
                "description": "Markdown 或 JSON 文本格式的文档结构"
              }
            ],
            "description": "完整文档结构，每个章节必须包含 title 和 content（正文段落），子章节放在 sections 数组中。示例：{\"chapters\":[{\"title\":\"1. 概述\",\"content\":\"本文档描述系统架构...\",\"sections\":[{\"title\":\"1.1 背景\",\"content\":\"系统用于...\"}]}]}。不要只传标题大纲，content 必须是该章节的完整正文内容。"
          }
        },
        "required": [
          "system_name",
          "document_title",
          "doc_plan"
        ],
        "additionalProperties": false
      },
      "execution": {
        "runtime": "python",
        "fixed_args": [
          "--project-root",
          "{project_root}",
          "--no-refresh-with-word"
        ],
        "arg_bindings": {
          "system_name": {
            "flag": "--system-name",
            "serializer": "string"
          },
          "document_title": {
            "flag": "--document-title",
            "serializer": "string"
          },
          "version": {
            "flag": "--version",
            "serializer": "string"
          },
          "doc_plan": {
            "flag": "--doc-plan",
            "serializer": "json_file",
            "text_normalizer": "chaptered_document"
          },
          "output_name": {
            "flag": "--output",
            "serializer": "attachment_output_name"
          }
        },
        "attachment": {
          "mime_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "default_name_template": "{document_title}.docx"
        }
      },
      "status": {
        "label": "生成文档文件",
        "start": "正在根据已整理的文档结构生成可下载文件。",
        "success": "文档文件已生成，可直接下载。",
        "failure": "文档文件生成失败。"
      }
    }
  ]
}
